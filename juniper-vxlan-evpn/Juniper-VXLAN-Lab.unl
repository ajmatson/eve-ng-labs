<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<lab name="Juniper-VXLAN-Lab" id="39b57858-d1fe-41b5-8ce2-fa4743da9413" version="1" scripttimeout="600" countdown="0" linkwidth="1" lock="0" grid="1" author="Alan Matson" sat="-1">
  <description>A simple lab that will teach you how to setup VxLAN and OSPF/eBGP to extend VLANs across datacenters.</description>
  <body>1) Setup each core switch for OSPF and eBGP to ensure routes are exchanged.
2)</body>
  <topology>
    <nodes>
      <node id="1" name="CaliforniaCore" type="qemu" template="vjunosswitch" image="vjunosswitch-24.4R1.9" console="telnet" cpu="4" cpulimit="0" ram="16384" ethernet="11" uuid="c967dad2-89f4-40ce-a208-f4d43c804a01" qemu_options="-machine type=pc,accel=kvm -serial mon:stdio -nographic -smbios type=1,product=VM-VEX -cpu IvyBridge,ibpb=on,md-clear=on,spec-ctrl=on,ssbd=on,svm=on,vmx=on,model-id=&quot;AMD VMX&quot;" qemu_version="5.2.0" qemu_arch="x86_64" qemu_nic="virtio-net-pci" eth_format="ge-0/0/{0-9}" eth_name="[&quot;fxp0&quot;]" delay="0" sat="-1" icon="Juniper-2D-Switch-S.svg" width="0" config="0" left="241" top="68">
        <interface id="1" name="ge-0/0/0" type="ethernet" network_id="1" vid="1" labelpos="0.5" stub="0" width="1" curviness="10" beziercurviness="150" round="0" midpoint="0.5" srcpos="0.15" dstpos="0.85"/>
        <interface id="2" name="ge-0/0/1" type="ethernet" network_id="2" vid="1" labelpos="0.5" stub="0" width="1" curviness="10" beziercurviness="150" round="0" midpoint="0.5" srcpos="0.15" dstpos="0.85"/>
      </node>
      <node id="2" name="NewYorkCore" type="qemu" template="vjunosswitch" image="vjunosswitch-24.4R1.9" console="telnet" cpu="4" cpulimit="0" ram="16384" ethernet="11" uuid="17794840-2b83-4938-b144-453e050b0ab2" qemu_options="-machine type=pc,accel=kvm -serial mon:stdio -nographic -smbios type=1,product=VM-VEX -cpu IvyBridge,ibpb=on,md-clear=on,spec-ctrl=on,ssbd=on,svm=on,vmx=on,model-id=&quot;AMD VMX&quot;" qemu_version="5.2.0" qemu_arch="x86_64" qemu_nic="virtio-net-pci" eth_format="ge-0/0/{0-9}" eth_name="[&quot;fxp0&quot;]" delay="0" sat="-1" icon="Juniper-2D-Switch-S.svg" width="0" config="0" left="839" top="67">
        <interface id="1" name="ge-0/0/0" type="ethernet" network_id="1" vid="1" labelpos="0.5" stub="0" width="1" curviness="10" beziercurviness="150" round="0" midpoint="0.5" srcpos="0.15" dstpos="0.85"/>
        <interface id="2" name="ge-0/0/1" type="ethernet" network_id="3" vid="1" labelpos="0.5" stub="0" width="1" curviness="10" beziercurviness="150" round="0" midpoint="0.5" srcpos="0.15" dstpos="0.85"/>
      </node>
      <node id="3" name="NewYorkPC" type="vpcs" template="vpcs" image="" ethernet="1" delay="0" sat="-1" icon="PC-2D-Desktop-Generic-S.svg" width="0" config="0" left="841" top="285">
        <interface id="0" name="eth0" type="ethernet" network_id="3" vid="1" labelpos="0.5" stub="0" width="1" curviness="10" beziercurviness="150" round="0" midpoint="0.5" srcpos="0.15" dstpos="0.85"/>
      </node>
      <node id="4" name="CalforniaPC" type="vpcs" template="vpcs" image="" ethernet="1" delay="0" sat="-1" icon="PC-2D-Desktop-Generic-S.svg" width="0" config="0" left="244" top="286">
